{
  "name": "encheres-montres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "property": "node --test test/property/*.test.mjs",
    "acceptance:generate": "node scripts/generate-acceptance.mjs",
    "acceptance": "pnpm acceptance:generate && node --test .ai/tasks/LOT-001/acceptance/generated/*.test.mjs .ai/tasks/PRICE-001/acceptance/generated/*.test.mjs .ai/tasks/APP-001/acceptance/generated/*.test.mjs .ai/tasks/IMPORT-001/acceptance/generated/*.test.mjs",
    "app:start": "node --env-file-if-exists=.env bin/app.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "cheerio": "^1.2.0",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1"
  }
}
